<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flor de hoy</title>
  <style>
    body {
      background-color: #f7ede2;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
    }
    .card {
      background: #ffffff;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      text-align: center;
      max-width: 350px;
      width: 100%;
    }
    #date {
      font-size: 0.9rem;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .flower-container img {
      width: 180px;
      height: 180px;
      object-fit: cover;
      border-radius: 50%;
      margin: 20px 0;
    }
    #flower-name {
      color: #84a59d;
      margin-bottom: 10px;
    }
    #phrase {
      color: #555;
      font-style: italic;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1 id="date"></h1>
    <div class="flower-container">
      <img id="flower-img" src="" alt="Flor del día">
    </div>
    <h2 id="flower-name"></h2>
    <p id="phrase"></p>
  </div>

  <script>
    const content = [
      {
        name: "Girasol",
        img: "https://images.unsplash.com/photo-1597848212624-a19eb35e2651?w=400",
        phrase: "Mantén tu rostro siempre hacia la luz del sol y las sombras caerán tras de ti."
      },
      {
        name: "Rosa",
        img: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=400",
        phrase: "La belleza reside en los detalles más sencillos."
      },
      {
        name: "Margarita",
        img: "https://images.unsplash.com/photo-1606041008023-472dfb5e530f?w=400",
        phrase: "Florece donde sea que la vida te haya plantado."
      },
      {
        name: "Orquídea",
        img: "https://images.unsplash.com/photo-1525310072745-f49212b5ac6d?w=400",
        phrase: "Cada logro importante toma su propio tiempo para florecer."
      }
    ];

    const today = new Date();
    const dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / 1000 / 60 / 60 / 24);
    const todayData = content[dayOfYear % content.length];

    document.getElementById('date').innerText = today.toLocaleDateString('es-ES', { weekday: 'long', month: 'short', day: 'numeric' });
    document.getElementById('flower-img').src = todayData.img;
    document.getElementById('flower-name').innerText = todayData.name;
    document.getElementById('phrase').innerText = `"${todayData.phrase}"`;
  </script>
</body>
</html>
